PORT=8080
HOST=0.0.0.0
ENV=development
JWT_SECRET=dev-secret-change-me
LOG_REQUESTS=true
SERVER_ENGINE=shelf
STORAGE_PATH=./storage
RATE_LIMIT=100

# App runtime — use transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dart_serve_testing

# Migrations — use direct/session connection (Supabase port 5432)
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/dart_serve_testing
